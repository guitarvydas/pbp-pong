        <mxCell id="11_Sound_title" value="Sound — three tones tapped from the sync generator" style="text;html=1;fontSize=18;fontStyle=1;fontColor=#e6edf3;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="24" width="520" height="28" as="geometry" />
        </mxCell>
        <mxCell id="11_Sound_note_1" value="&#39;Ping&#39; (paddle hit) = VBALL16 ~490 Hz via C2a/C3a; &#39;pong&#39; (wall bounce) = VBALL32 ~980 Hz via F3a/C3b; score tone from 555 (G4) gated by 32V. C4b sums them; C1b mutes during attract. Output is unamplified to the monitor." style="text;html=1;fontSize=10;fontColor=#8b949e;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="56" width="900" height="56" as="geometry" />
