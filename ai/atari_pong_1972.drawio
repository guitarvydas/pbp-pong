        <mxCell id="12_Game_Control_title" value="Game Control — coin latch, attract, serve timer" style="text;html=1;fontSize=18;fontStyle=1;fontColor=#e6edf3;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="24" width="520" height="28" as="geometry" />
        </mxCell>
        <mxCell id="12_Game_Control_note_1" value="Coin switch debounced by C9c/C9f (sheet 01). Power-on / coin latch built from discrete transistors Q1,Q2 (+Q3 antenna guard) sets RUN / ATTRACT. 555 (F4) is the ~1.7 s serve one-shot. Reaching 11 or 15 asserts STOP_G → attract." style="text;html=1;fontSize=10;fontColor=#8b949e;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="56" width="900" height="56" as="geometry" />
        </mxCell>
