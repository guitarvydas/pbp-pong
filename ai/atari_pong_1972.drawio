        <mxCell id="01_Main_Clock_note_1" value="14.318 MHz crystal oscillator (C9e,C9d gates) buffered by E6d, divided by 2 in JK flip-flop F6a → 7.159 MHz master clock CLK7M. F6b (other half of F6) is the 256H bit of the horizontal counter. Analog osc network shown as stubs." style="text;html=1;fontSize=10;fontColor=#8b949e;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="56" width="760" height="56" as="geometry" />
