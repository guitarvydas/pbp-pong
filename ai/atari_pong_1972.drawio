        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="08_Horizontal_Ball_Control_title" value="Horizontal Ball Control — 9-bit phase counter" style="text;html=1;fontSize=18;fontStyle=1;fontColor=#e6edf3;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="24" width="520" height="28" as="geometry" />
        </mxCell>
        <mxCell id="08_Horizontal_Ball_Control_note_1" value="9-bit counter (9316s G7,H7 + JK G6b) reloads at 511. The phase vs the main horizontal counter sets ball X; the MOVE pulse width nudges it left/right. F1 (7493) counts hits to speed up the ball; JK pair H2a/H2b is the speed state machine; H3b (sheet 06) sets direction." style="text;html=1;fontSize=10;fontColor=#8b949e;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="56" width="980" height="70" as="geometry" />
        </mxCell>
