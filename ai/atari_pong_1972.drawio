        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="09_Vertical_Ball_Control_title" value="Vertical Ball Control — angle from paddle-hit position" style="text;html=1;fontSize=18;fontStyle=1;fontColor=#e6edf3;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="24" width="520" height="28" as="geometry" />
        </mxCell>
        <mxCell id="09_Vertical_Ball_Control_note_1" value="8-bit counter (9316s A3,B3) sets ball Y; its reload value (from 7483 adder B4) encodes the rebound angle. D flip-flops B5a,A5a,A5b latch where the ball hit the paddle; AOI 7450s (A6,B6) mux the two paddles&#39; top 3 bits; JK A2a + XORs (A4) bounce off top/bottom." style="text;html=1;fontSize=10;fontColor=#8b949e;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="56" width="980" height="70" as="geometry" />
        </mxCell>
        <mxCell id="09_Vertical_Ball_Control_A3_body" value="A3 9316 4-bit sync counter" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#0d1117;strokeColor=#1f6feb;fontColor=#e6edf3;fontStyle=1;fontSize=11;verticalAlign=middle;arcSize=6;" vertex="1" parent="1">
