        <mxCell id="07_Score_title" value="Score — two 2-digit 7-segment numbers" style="text;html=1;fontSize=18;fontStyle=1;fontColor=#e6edf3;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="24" width="520" height="28" as="geometry" />
        </mxCell>
        <mxCell id="07_Score_note_1" value="Decade counters C7,D7 (+JK C8a,C8b for tens) hold each score. 74153 muxes (C6,D6) steer a digit to 7448 decoder (C5). A bank of 7410 NAND gates (C4,D4,D5,E2) paints each segment in its screen region; 7430 (D3) sums them. Combinational segment-decode inputs shown on the screen-position buses (4H,8H,4V,8V,16V,16H)." style="text;html=1;fontSize=10;fontColor=#8b949e;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1">
